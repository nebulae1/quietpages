---
// Reusable bordered callout box, styled after a "Key Points" module.
// Uses only default Tailwind classes — no custom theme tokens required.
//
// Usage:
// <Callout title="Key Points">
//   <li>First point.</li>
//   <li>Second point.</li>
// </Callout>
//
// <Callout title="Kid's-Eye View" eyebrow="As told by our 10-year-old food critic">
//   <li>A couple of sentences in a kid's voice.</li>
// </Callout>

interface Props {
  title: string;
  eyebrow?: string;
}

const { title, eyebrow } = Astro.props;
---

<div class="my-10 rounded-lg border border-gray-300 px-6 py-8 sm:px-10">
  <div class="flex items-center gap-4">
    <span class="h-px flex-1 bg-gray-300"></span>
    <span class="text-xs font-semibold uppercase tracking-[0.2em] text-amber-700 whitespace-nowrap">
      {title}
    </span>
    <span class="h-px flex-1 bg-gray-300"></span>
  </div>

  {eyebrow && (
    <p class="mt-3 text-center text-sm italic text-gray-500">{eyebrow}</p>
  )}

  <ul class="mt-6 space-y-4 marker:text-amber-700 list-disc pl-5 text-base leading-relaxed text-gray-800">
    <slot />
  </ul>
</div>
